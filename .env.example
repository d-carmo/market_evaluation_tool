# ── Tickers ──────────────────────────────────────────────────────────────────
# Comma-separated ticker symbols per market type.
STOCK_TICKERS=AAPL,MSFT,NVDA,TSLA
CRYPTO_TICKERS=BTC-USD,ETH-USD,SOL-USD
COMMODITY_TICKERS=GC=F,CL=F,SI=F

# ── Data ─────────────────────────────────────────────────────────────────────
# Historical depth in calendar days.
HISTORICAL_DAYS=365
# How long to keep cached data before re-fetching (hours).
CACHE_TTL_HOURS=6

# ── Signal weights ────────────────────────────────────────────────────────────
# Relative importance of each indicator in the composite score.
SIGNAL_WEIGHTS_RSI=1.0
SIGNAL_WEIGHTS_MACD=1.5
SIGNAL_WEIGHTS_TREND=2.0
SIGNAL_WEIGHTS_VOLUME=0.8
SIGNAL_WEIGHTS_BB=1.0
SIGNAL_WEIGHTS_STOCH=0.8

# ── Prediction horizons ───────────────────────────────────────────────────────
# Days into the future for short and long forecasts.
FORECAST_SHORT=3
FORECAST_LONG=7

# ── Concurrency ───────────────────────────────────────────────────────────────
# Thread pool size for I/O-bound fetching.
MAX_FETCH_WORKERS=8
# Process pool size for CPU-bound feature/analysis work.
MAX_COMPUTE_WORKERS=4
